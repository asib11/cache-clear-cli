# medusa-cache-cli configuration
# Copy this to .env and adjust paths to your project

# ── Redis ──────────────────────────────────────────────────────────────────
# Your docker-compose maps Redis as  6380:6379
# So from HOST machine (where you run this CLI), use localhost:6380
REDIS_URL=localhost:6380

# No password in your setup — leave this empty
REDIS_PASSWORD=

# Redis DB index (Medusa v2 default: 0)
REDIS_DB=0

# ── Project paths ──────────────────────────────────────────────────────────
# Adjust these to where your projects live on disk
NEXTJS_DIR=./storefront
MEDUSA_DIR=./backend
